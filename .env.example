JELLYFIN_URL=http://your-jellyfin-host:8096
JELLYFIN_API_KEY=your_jellyfin_api_key
TMDB_API_KEY=your_tmdb_api_key
TMDB_LANGUAGE=en-US
# Hours between automatic syncs; 0 turns one off (manual "Sync now" only).
LIBRARY_SCAN_INTERVAL_HOURS=6
TMDB_SYNC_INTERVAL_HOURS=24
MISSING_RECHECK_INTERVAL_HOURS=24
XREL_SYNC_INTERVAL_HOURS=6
# Sign in with Jellyfin accounts (default). false = no sign-in, anyone who can
# reach Jellylens gets full access.
# AUTH_ENABLED=true
# Downloads page: where downloads and their extracted files go on the host
# (mounted at /downloads). Unset: ./downloads next to the compose file.
# DOWNLOADS_PATH=/srv/media/downloads
# The library's disks inside the container, one folder per disk with movies/
# and shows/ (mount each disk at /library/<disk> in a compose override). The
# library scan reads them, Organize moves finished downloads into them.
LIBRARY_DIR=/library
# Downloads page: a ddownload.com premium account and/or a Real-Debrid token,
# and passwords tried on archives (comma-separated).
# DDOWNLOAD_LOGIN=
# DDOWNLOAD_PASSWORD=
# REALDEBRID_TOKEN=
# ARCHIVE_PASSWORDS=
# WCX mirrors on title pages: unset turns the WCX lookups off.
# WCX_URL=
# WCX_API_URL=
# Dev server only: extra hosts allowed to load `next dev` (e.g. your phone on
# the LAN), comma-separated with one wildcard label, e.g. 192.168.1.*
# DEV_ALLOWED_ORIGINS=
