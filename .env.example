JELLYFIN_URL=http://your-jellyfin-host:8096
JELLYFIN_API_KEY=your_jellyfin_api_key
TMDB_API_KEY=your_tmdb_api_key
TMDB_LANGUAGE=en-US
# Hours between automatic syncs; 0 turns one off (Sync on Settings only).
LIBRARY_SCAN_INTERVAL_HOURS=6
TMDB_SYNC_INTERVAL_HOURS=24
XREL_SYNC_INTERVAL_HOURS=6
WCX_SYNC_INTERVAL_HOURS=6
# Sign in with Jellyfin accounts (default). false = no sign-in, anyone who can
# reach Jellylens gets full access. The dev server reads DEV_AUTH_ENABLED
# instead, so a dev .env doesn't change production.
# AUTH_ENABLED=true
# DEV_AUTH_ENABLED=true
# Queue: where downloads and their extracted files go on the host
# (mounted at /downloads). Unset: ./downloads next to the compose file.
# DOWNLOADS_PATH=/srv/media/downloads
# The library's disks inside the container, one folder per disk with movies/
# and shows/ (mount each disk at /library/<disk> in a compose override). The
# library scan reads them, the Queue moves finished downloads into them.
LIBRARY_DIR=/library
# Queue: a ddownload.com premium account and/or a Real-Debrid token,
# and passwords tried on archives (comma-separated).
# DDOWNLOAD_LOGIN=
# DDOWNLOAD_PASSWORD=
# REALDEBRID_TOKEN=
# ARCHIVE_PASSWORDS=
# Favorite release groups (comma-separated), added at every start if
# missing; more can be added on Settings.
# P2P_GROUPS=
# SCENE_GROUPS=
# WCX: its latest releases on Discover, mirrors on title pages; unset turns
# it off. Its sync keeps out of the night (0-8 o'clock) in TZ.
# WCX_URL=
# WCX_API_URL=
# TZ=Europe/Vienna
# Dev server only: extra hosts allowed to load `next dev` (e.g. your phone on
# the LAN), comma-separated with one wildcard label, e.g. 192.168.1.*
# DEV_ALLOWED_ORIGINS=
